---
// AnubisReal
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>AnubisReal</title>
		<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@700&display=swap" rel="stylesheet">
	</head>
	<body>

		<div class="sticky-wrapper">
			<section class="section">

				<!-- TikTok (capa inferior) -->
				<a href="https://tiktok.com/@anubisreal" target="_blank" rel="noopener noreferrer" class="social-link" id="ttLink">
					<svg class="social-svg" id="ttSvg" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg">
						<path d="M16.656 1.029c1.637-0.025 3.262-0.012 4.886-0.025 0.054 2.031 0.878 3.859 2.189 5.213l-0.002-0.002c1.411 1.271 3.247 2.095 5.271 2.235l0.028 0.002v5.036c-1.912-0.048-3.71-0.489-5.331-1.247l0.082 0.034c-0.784-0.377-1.447-0.764-2.077-1.196l0.052 0.034c-0.012 3.649 0.012 7.298-0.025 10.934-0.103 1.853-0.719 3.543-1.707 4.954l0.020-0.031c-1.652 2.366-4.328 3.919-7.371 4.011l-0.014 0c-0.123 0.006-0.268 0.009-0.414 0.009-1.73 0-3.347-0.482-4.725-1.319l0.040 0.023c-2.508-1.509-4.238-4.091-4.558-7.094l-0.004-0.041c-0.025-0.625-0.037-1.25-0.012-1.862 0.49-4.779 4.494-8.476 9.361-8.476 0.547 0 1.083 0.047 1.604 0.136l-0.056-0.008c0.025 1.849-0.050 3.699-0.050 5.548-0.423-0.153-0.911-0.242-1.42-0.242-1.868 0-3.457 1.194-4.045 2.861l-0.009 0.030c-0.133 0.427-0.21 0.918-0.21 1.426 0 0.206 0.013 0.41 0.037 0.61l-0.002-0.024c0.332 2.046 2.086 3.59 4.201 3.59 0.061 0 0.121-0.001 0.181-0.004l-0.009 0c1.463-0.044 2.733-0.831 3.451-1.994l0.010-0.018c0.267-0.372 0.45-0.822 0.511-1.311l0.001-0.014c0.125-2.237 0.075-4.461 0.087-6.698 0.012-5.036-0.012-10.060 0.025-15.083z" fill="currentColor"/>
					</svg>
				</a>

				<!-- Instagram (capa superior) -->
				<a href="https://instagram.com/badboybmb" target="_blank" rel="noopener noreferrer" class="social-link" id="igLink">
					<svg class="social-svg" id="igSvg" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
						<path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z" fill="currentColor"/>
					</svg>
				</a>

				<h1 class="main-text" id="mainText" aria-label="Sígueme"></h1>

				<div class="scroll-indicator" id="scrollIndicator">
					<svg viewBox="0 0 24 36" fill="none" xmlns="http://www.w3.org/2000/svg">
						<rect x="1" y="1" width="22" height="34" rx="11" stroke="#0a0a0a" stroke-width="2" stroke-opacity="0.3"/>
						<circle class="scroll-dot" cx="12" cy="10" r="3" fill="#0a0a0a" fill-opacity="0.3"/>
					</svg>
				</div>

			</section>
		</div>

	</body>
</html>

<style>
	* { margin: 0; padding: 0; box-sizing: border-box; }

	body {
		width: 100%;
		background: #ffffff;
		font-family: 'Space Grotesk', sans-serif;
		overflow-x: hidden;
	}

	.sticky-wrapper { height: 800vh; }

	.section {
		position: sticky;
		top: 0;
		width: 100%;
		height: 100vh;
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
	}

	.social-svg {
		width: 400px;
		height: 400px;
		display: block;
		-webkit-mask-image: linear-gradient(to bottom, black 20%, transparent 80%);
		mask-image: linear-gradient(to bottom, black 20%, transparent 80%);
	}

	.social-link {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%) rotate(-20deg);
		color: rgb(220, 220, 220);
		z-index: 1;
		opacity: 0.15;
	}

	#ttLink { z-index: 1; }
	#igLink { z-index: 2; }

	.main-text {
		font-size: clamp(48px, 10vw, 110px);
		font-weight: 700;
		color: #0a0a0a;
		letter-spacing: -4px;
		text-transform: uppercase;
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		z-index: 3;
		pointer-events: none;
		display: flex;
		overflow: visible;
		white-space: nowrap;
	}

	.main-text .char {
		display: inline-block;
		will-change: transform, opacity, filter;
	}

	.scroll-indicator {
		position: absolute;
		bottom: 44px;
		left: 50%;
		transform: translateX(-50%);
		z-index: 4;
	}

	.scroll-indicator svg { width: 22px; height: 34px; }

	.scroll-dot { animation: scrolldown 1.8s ease infinite; }

	@keyframes scrolldown {
		0%   { transform: translateY(0);    opacity: 1; }
		80%  { transform: translateY(12px); opacity: 0; }
		100% { transform: translateY(0);    opacity: 0; }
	}
</style>

<script>
	function lerp(a: number, b: number, t: number) { return a + (b - a) * t; }
	function clamp(v: number, a: number, b: number) { return Math.min(Math.max(v, a), b); }
	function ease(t: number) { return t < 0.5 ? 4*t*t*t : 1 - Math.pow(-2*t+2, 3)/2; }

	function measureText(text: string) {
		const el = document.createElement('h1');
		el.style.cssText = `position:absolute;visibility:hidden;pointer-events:none;font-size:clamp(48px,10vw,110px);font-weight:700;letter-spacing:-4px;text-transform:uppercase;font-family:'Space Grotesk',sans-serif;white-space:nowrap;`;
		el.textContent = text;
		document.body.appendChild(el);
		const w = el.offsetWidth, h = el.offsetHeight;
		document.body.removeChild(el);
		return { w, h };
	}

	function buildChars(container: HTMLElement, text: string) {
		container.innerHTML = '';
		container.style.transform = 'translate(-50%, -50%)';
		return text.split('').map((ch: string) => {
			const s = document.createElement('span');
			s.className = 'char';
			s.textContent = ch;
			s.style.cssText = 'opacity:1;transform:none;filter:none;display:inline-block;';
			container.appendChild(s);
			return s;
		});
	}

	const wrapper   = document.querySelector('.sticky-wrapper') as HTMLElement;
	const igLink    = document.getElementById('igLink') as HTMLElement;
	const igSvg     = document.getElementById('igSvg') as HTMLElement;
	const ttLink    = document.getElementById('ttLink') as HTMLElement;
	const ttSvg     = document.getElementById('ttSvg') as HTMLElement;
	const mainText  = document.getElementById('mainText') as HTMLElement;
	const indicator = document.getElementById('scrollIndicator') as HTMLElement;

	const TEXT_SIGUEME   = 'Sígueme';
	const TEXT_ANUBIS    = 'AnubisReal';
	const TEXT_BADBOY    = 'badboymtz';

	// Medir textos
	const { w: wAnubis, h: hAnubis } = measureText(TEXT_ANUBIS);
	const { w: wBadboy } = measureText(TEXT_BADBOY);
	const FINAL_SIZE     = hAnubis * 0.88;
	const GAP            = 4;
	const totalW         = FINAL_SIZE + GAP + wAnubis;
	const linkFinalX     = -(totalW / 2) + FINAL_SIZE / 2;
	const textFinalX     = totalW / 2 - wAnubis / 2;
	const totalWBadboy   = FINAL_SIZE + GAP + wBadboy;
	const ttLinkFinalX   = -(totalWBadboy / 2) + FINAL_SIZE / 2;
	const textFinalXBadboy = totalWBadboy / 2 - wBadboy / 2;

	let charsA: HTMLElement[] = buildChars(mainText, TEXT_SIGUEME);
	let charsB: HTMLElement[] = [];
	let phase = 'A'; // A=sígueme, B=anubisreal-ig, C=tiktok-bg, D=anubisreal-tt

	// Estado inicial TikTok: oculto
	ttLink.style.opacity = '0';

	function onScroll() {
		const scrolled    = -wrapper.getBoundingClientRect().top;
		const totalScroll = wrapper.offsetHeight - window.innerHeight;
		const raw         = clamp(scrolled / totalScroll, 0, 1);

		// ─── BLOQUE 1: Instagram (raw 0 → 0.5) ───
		const b1   = clamp(raw / 0.5, 0, 1);
		const p1a  = clamp(b1 / 0.4, 0, 1);
		const ep1a = ease(p1a);
		const p1b  = clamp((b1 - 0.4) / 0.6, 0, 1);
		const ep1b = ease(p1b);
		const p1c  = clamp((b1 - 0.7) / 0.3, 0, 1);

		// ─── BLOQUE 2: TikTok (raw 0.5 → 1) ───
		const b2   = clamp((raw - 0.5) / 0.5, 0, 1);
		const p2a  = clamp(b2 / 0.4, 0, 1);
		const ep2a = ease(p2a);
		const p2b  = clamp((b2 - 0.4) / 0.6, 0, 1);
		const ep2b = ease(p2b);
		const p2c  = clamp((b2 - 0.7) / 0.3, 0, 1);

		// ─── GESTIÓN DE FASES (con reversiones) ───
		if (p2c > 0 && phase === 'B') {
			// Avanzar B → C
			phase = 'C';
			mainText.innerHTML = '';
			mainText.style.transform = `translate(calc(-50% + ${textFinalXBadboy}px), -50%)`;
			charsB = TEXT_BADBOY.split('').map((ch: string) => {
				const s = document.createElement('span');
				s.className = 'char'; s.textContent = ch;
				s.style.cssText = 'opacity:0;transform:translateY(30px) scale(0.8);filter:blur(10px);display:inline-block;';
				mainText.appendChild(s); return s;
			});
		} else if (p2c === 0 && b2 < 0.7 && phase === 'C') {
			// Revertir C → B
			phase = 'B';
			mainText.innerHTML = '';
			mainText.style.transform = `translate(calc(-50% + ${textFinalX}px), -50%)`;
			charsB = TEXT_ANUBIS.split('').map((ch: string) => {
				const s = document.createElement('span');
				s.className = 'char'; s.textContent = ch;
				s.style.cssText = 'opacity:1;transform:none;filter:none;display:inline-block;';
				mainText.appendChild(s); return s;
			});
		}

		if (p1c > 0 && phase === 'A') {
			// Avanzar A → B
			phase = 'B';
			mainText.innerHTML = '';
			mainText.style.transform = `translate(calc(-50% + ${textFinalX}px), -50%)`;
			charsB = TEXT_ANUBIS.split('').map((ch: string) => {
				const s = document.createElement('span');
				s.className = 'char'; s.textContent = ch;
				s.style.cssText = 'opacity:0;transform:translateY(30px) scale(0.8);filter:blur(10px);display:inline-block;';
				mainText.appendChild(s); return s;
			});
		} else if (p1c === 0 && b1 < 0.7 && phase === 'B' && b2 === 0) {
			// Revertir B → A
			phase = 'A';
			charsA = buildChars(mainText, TEXT_SIGUEME);
		}

		// ─── RENDER ───

		// Instagram SVG mask
		igSvg.style.maskImage = `linear-gradient(to bottom, black ${lerp(20,100,ep1a)}%, transparent ${lerp(80,100,ep1a)}%)`;

		// Instagram tamaño y posición
		igSvg.style.width  = lerp(400, FINAL_SIZE, ep1b) + 'px';
		igSvg.style.height = lerp(400, FINAL_SIZE, ep1b) + 'px';
		const igRot = b1 <= 0.4 ? lerp(-20, 0, ep1a) : 0;
		igLink.style.transform = `translate(calc(-50% + ${lerp(0, linkFinalX, ep1b)}px), -50%) rotate(${igRot}deg)`;

		if (b1 <= 0.4) {
			const c = Math.round(lerp(220, 10, ep1a));
			igLink.style.color   = `rgb(${c},${c},${c})`;
			igLink.style.opacity = b2 > 0 ? String(lerp(1, 0, ease(clamp(b2 * 3, 0, 1)))) : '0.15';
		} else {
			igLink.style.color   = `rgba(0,0,0,${lerp(0.6,1,ep1b)})`;
			igLink.style.opacity = b2 > 0 ? String(lerp(1, 0, ease(clamp(b2 * 3, 0, 1)))) : String(lerp(0.15, 1, ep1b));
		}

		// Texto fase A (Sígueme dispersándose)
		if (phase === 'A') {
			charsA.forEach((c: HTMLElement, i: number) => {
				const delay = i / charsA.length;
				const cp    = clamp((p1b - delay * 0.4) / 0.6, 0, 1);
				const ecp   = ease(cp);
				const dir   = i % 2 === 0 ? 1 : -1;
				c.style.transform = `translateY(${-ecp*40}px) translateX(${dir*ecp*20}px) scale(${1-ecp*0.5})`;
				c.style.opacity   = String(1 - ecp);
				c.style.filter    = `blur(${ecp*8}px)`;
			});
		}

		// Texto fase B (AnubisReal entrando)
		if (phase === 'B') {
			const progress = b2 === 0 ? p1c : 1;
			charsB.forEach((c: HTMLElement, i: number) => {
				const delay = i / charsB.length;
				const cp    = clamp((progress - delay * 0.5) / 0.5, 0, 1);
				const ecp   = ease(cp);
				c.style.transform = `translateY(${(1-ecp)*30}px) scale(${0.8+ecp*0.2})`;
				c.style.opacity   = String(ecp);
				c.style.filter    = `blur(${(1-ecp)*10}px)`;
			});
		}

		// Texto fase C (badboymtz entrando)
		if (phase === 'C') {
			charsB.forEach((c: HTMLElement, i: number) => {
				const delay = i / charsB.length;
				const cp    = clamp((p2c - delay * 0.5) / 0.5, 0, 1);
				const ecp   = ease(cp);
				c.style.transform = `translateY(${(1-ecp)*30}px) scale(${0.8+ecp*0.2})`;
				c.style.opacity   = String(ecp);
				c.style.filter    = `blur(${(1-ecp)*10}px)`;
			});
		}

		// TikTok SVG mask
		ttSvg.style.maskImage = `linear-gradient(to bottom, black ${lerp(20,100,ep2a)}%, transparent ${lerp(80,100,ep2a)}%)`;

		// TikTok tamaño y posición
		ttSvg.style.width  = lerp(400, FINAL_SIZE, ep2b) + 'px';
		ttSvg.style.height = lerp(400, FINAL_SIZE, ep2b) + 'px';
		const ttRot = b2 <= 0.4 ? lerp(-20, 0, ep2a) : 0;
		ttLink.style.transform = `translate(calc(-50% + ${lerp(0, ttLinkFinalX, ep2b)}px), -50%) rotate(${ttRot}deg)`;

		if (b2 <= 0.4) {
			const c = Math.round(lerp(220, 10, ep2a));
			ttLink.style.color   = `rgb(${c},${c},${c})`;
			ttLink.style.opacity = String(lerp(0, 0.15, ease(clamp(b2/0.1, 0, 1))));
		} else {
			ttLink.style.color   = `rgba(0,0,0,${lerp(0.6,1,ep2b)})`;
			ttLink.style.opacity = String(lerp(0.15, 1, ep2b));
		}

		indicator.style.opacity = String(clamp(1 - raw * 4, 0, 1));
	}

	window.addEventListener('scroll', onScroll, { passive: true });
	onScroll();
</script>
